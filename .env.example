# Copy to .env and fill in. The .env file is git-ignored and must never be committed.
# The browser never sees any of these values; only server/ reads them.

# Which provider answers: "openai", "xai", or a comma list such as "openai,xai". With a
# list, the first answers every call and the next is tried only when the one before it
# declines the request. Other failures (bad key, rate limit) are reported, never skipped.
PROVIDER=openai

# xAI (Grok), used when PROVIDER=xai. Verified against docs.x.ai 2026-09-27.
XAI_API_KEY=
# grok-4.7 is the flagship with image input. "grok-4.7-latest" tracks the newest release.
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
# Reasoning tokens count inside this cap.
XAI_MAX_OUTPUT_TOKENS=25000
# Optional. low, medium, high, xhigh on models that take it (grok-4.7 does, grok-4.20 does
# not). Leave empty to let the model use its own default. A model that rejects the value is
# retried once without it.
XAI_REASONING_EFFORT=

# OpenAI
OPENAI_API_KEY=
# Model ID, verified on OpenAI's model page 2026-09-25.
OPENAI_MODEL=gpt-6-astra
# Override only if you use a proxy or compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# max_output_tokens counts reasoning tokens too. OpenAI recommends at least 25000.
# Too low and a call can end with status "incomplete" before any visible text.
OPENAI_MAX_OUTPUT_TOKENS=25000
# Reasoning effort: minimal, low, medium, high, xhigh, max. gpt-6-astra rejects "none".
# "medium" is the default; "low" is cheaper and noticeably flatter.
OPENAI_REASONING_EFFORT=medium

# Server
PORT=8787

# Password the browser must supply (HTTP Basic Auth). Required when hosted: the server
# refuses to start on Railway (or with NODE_ENV=production) if this is empty.
# Leave empty on your own PC to run open.
APP_PASSWORD=
# Model calls allowed per IP address per 5 minutes.
RATE_LIMIT_PER_5MIN=30
