# Copy to .env and fill in. The .env file is git-ignored and must never be committed.
# The browser never sees any of these values; only server/ reads them.

# Which provider adapter the server dispatches to. Only "openai" exists today.
PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
# Model ID, verified on OpenAI's model page 2026-09-25.
OPENAI_MODEL=gpt-6-astra
# Override only if you use a proxy or compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# max_output_tokens counts reasoning tokens too. OpenAI recommends at least 25000.
# Too low and a call can end with status "incomplete" before any visible text.
OPENAI_MAX_OUTPUT_TOKENS=25000
# Reasoning effort: minimal, low, medium, high, xhigh, max. gpt-6-astra rejects "none".
# "low" is enough for prompt writing and the cheapest that works.
OPENAI_REASONING_EFFORT=low

# Server
PORT=8787
